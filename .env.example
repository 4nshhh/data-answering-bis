# Copy to .env (never commit .env). All values below are placeholders.

# LLM provider selection: "groq" (default) or "gemini".
LLM_PROVIDER=groq

# Groq configuration (default provider).
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b).
GROQ_MODEL=

# Gemini configuration (alternative provider).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: preload retrieval models at server startup (1 = enabled).
# Server-only shortcut for app.generator.warmup(); direct-library
# backends (from app.generator import answer, warmup) call warmup()
# explicitly instead of setting this.
BIS_WARMUP=0
