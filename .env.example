# Copy to .env (never commit .env). All values below are placeholders.

# LLM provider selection: "gemini" (default) or "groq" (fallback).
LLM_PROVIDER=gemini

# Gemini configuration (default provider).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq configuration (fallback / explicit alternative).
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b).
GROQ_MODEL=

# Optional: preload retrieval models at server startup (1 = enabled).
# Server-only shortcut for answering.generator.warmup(); direct-library
# backends (from answering.generator import answer, warmup) call warmup()
# explicitly instead of setting this.
BIS_WARMUP=0

# Optional: pin the retrieval device (default: CUDA when available,
# otherwise CPU with a warning). Read by retrieval/models.py only.
# BIS_DEVICE=cpu

# Optional: PostgreSQL/pgvector production path only (PgVectorStore).
# DATABASE_URL=
